DATABASE_URL="mysql://root@127.0.0.1:3306/maccms"
AUTH_SECRET="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-a-long-random-string"
COOKIE_SECURE="0"
REDIS_URL="redis://127.0.0.1:6379"
WARM_HOST="localhost"
HTML_CACHE_SECONDS="60"
# 生产服务内置定时任务检查；设为 0 可关闭，改由外部 Cron 调用 /api/cron
INTERNAL_CRON="1"
HTML_STALE_SECONDS="120"
COLLECT_MAX_PARALLEL="2"
CRON_COLLECT_PARALLEL="2"
