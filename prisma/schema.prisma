  actorBirtharea String  @default("") @db.VarChar(255) @map("actor_birtharea")
  actorBlood     String  @default("") @db.VarChar(255) @map("actor_blood")
  actorStarsign  String  @default("") @db.VarChar(255) @map("actor_starsign")
  actorSchool    String  @default("") @db.VarChar(255) @map("actor_school")
  actorWorks     String  @default("") @db.VarChar(255) @map("actor_works")
  actorTag       String  @default("") @db.VarChar(255) @map("actor_tag")
  actorClass     String  @default("") @db.VarChar(255) @map("actor_class")
  actorLevel     Int     @default(0) @map("actor_level")
  actorTime      Int     @default(0) @map("actor_time")
  actorTimeAdd   Int     @default(0) @map("actor_time_add")
  actorTimeHits  Int     @default(0) @map("actor_time_hits")
  actorTimeMake  Int     @default(0) @map("actor_time_make")
  actorHits      Int     @default(0) @map("actor_hits")
