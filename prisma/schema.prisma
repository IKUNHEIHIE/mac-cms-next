  actorSex       String  @default("") @db.VarChar(255) @map("actor_sex")
  actorColor     String  @default("") @db.VarChar(255) @map("actor_color")
  actorPic       String  @default("") @db.VarChar(1024) @map("actor_pic")
  actorBlurb     String  @default("") @db.VarChar(255) @map("actor_blurb")
  actorRemarks   String  @default("") @db.VarChar(255) @map("actor_remarks")
