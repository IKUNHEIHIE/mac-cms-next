  actorDown      Int     @default(0) @map("actor_down")
  actorTpl       String  @default("") @db.VarChar(255) @map("actor_tpl")
  actorJumpurl   String  @default("") @db.VarChar(255) @map("actor_jumpurl")
  actorContent   String? @db.MediumText @map("actor_content")

  @@index([typeId])
  @@index([actorName])
  @@map("mac_actor")
}

